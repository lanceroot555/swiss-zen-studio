# Dimaloka — Environment Configuration
# Copy file ini jadi `.env` lalu isi nilai aslinya. JANGAN commit `.env`.

# ── Supabase / Lovable Cloud ────────────────────────────────────────────────
# Project ID & URL: Lovable → Cloud → Settings
SUPABASE_PROJECT_ID="ptfwzcqsilhecicxtovi"
SUPABASE_URL="https://ptfwzcqsilhecicxtovi.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
# SERVICE ROLE = bypass RLS. Hanya untuk server. Jangan pernah expose ke client.
SUPABASE_SERVICE_ROLE_KEY="sb_secret_..."

# ── Client-side (dibakar saat build via Vite) ───────────────────────────────
# Wajib sama nilainya dengan SUPABASE_* di atas.
VITE_SUPABASE_PROJECT_ID="ptfwzcqsilhecicxtovi"
VITE_SUPABASE_URL="https://ptfwzcqsilhecicxtovi.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# ── Opsional (v1 belum dipakai, siap untuk nanti) ───────────────────────────
# GA4 & Meta Pixel — diisi via admin CMS juga bisa (site_config.analytics)
# GA4_ID=""
# META_PIXEL_ID=""

# Resend (email notifikasi order/kontak) — menunggu domain terverifikasi
# RESEND_API_KEY=""
# EMAIL_FROM="noreply@dimaloka.id"
